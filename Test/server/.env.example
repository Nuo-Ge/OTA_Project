# 服务监听配置
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# 华为云 IoTDA 配置
PROJECT_ID=your-huawei-project-id
AK=your-access-key
SK=your-secret-key
INSTANCE_ID=your-instance-id
ENDPOINT=https://iotda.cn-north-4.myhuaweicloud.com
DEVICE_ID=your-device-id

# 登录鉴权配置
# 管理员用户名
ADMIN_USERNAME=admin
# 管理员密码（明文，启动时自动哈希）与 ADMIN_PASSWORD_HASH 二选一即可
ADMIN_PASSWORD=change-me
# 或者：预生成 bcrypt 哈希（若同时设置，优先使用哈希）
# ADMIN_PASSWORD_HASH=$2a$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# JWT 签名密钥（生产环境务必改成足够随机的长字符串）
JWT_SECRET=change-me-to-a-long-random-secret
# JWT 有效期
JWT_EXPIRES_IN=8h